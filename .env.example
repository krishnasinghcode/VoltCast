CONTRACT_VERSION=1.0.0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=telemetry.raw

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cvi
POSTGRES_USER=cvi_app
POSTGRES_PASSWORD=changeme_local_only
# Read-only role, used ONLY by the SQL sandbox feature in the api service
POSTGRES_READONLY_USER=cvi_readonly
POSTGRES_READONLY_PASSWORD=changeme_local_only_readonly

# Mongo
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=cvi_telemetry

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Service URLs (for inter-service HTTP calls)
DATA_GEN_URL=http://data-gen:8001
INGESTION_URL=http://ingestion:8002
ML_URL=http://ml:8003
API_URL=http://api:8000

# Auth
JWT_SECRET=changeme_local_only_jwt_secret
JWT_EXPIRY_MINUTES=120

# Misc
RAW_RETENTION_DAYS=14

# --- Part D: dashboard api (services/dashboard/api) — all optional, defaults shown ---
# Requests per minute per user per endpoint (login: per client IP). Raise it for k6 runs.
RATE_LIMIT_PER_MINUTE=120
# Demo accounts created by seed_users.py on api start-up (local demo only — change for anything shared)
SEED_ADMIN_PASSWORD=admin123
SEED_MANAGER_PASSWORD=manager123
SEED_VIEWER_PASSWORD=viewer123
# Browser origins allowed to call the api directly (only needed for `npm run dev` without the vite proxy)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SQL_SANDBOX_ENABLED=true
WS_PUSH_INTERVAL_SECONDS=2
