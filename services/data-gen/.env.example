CONTRACT_VERSION=1.0.0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=telemetry.raw
KAFKA_PARTITIONS=12

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cvi
POSTGRES_USER=cvi_app
POSTGRES_PASSWORD=changeme_local_only
# Optional full override
# DATABASE_URL=postgresql+psycopg2://cvi_app:changeme_local_only@postgres:5432/cvi

# Fleet defaults
DEFAULT_SEED=42
DEFAULT_VEHICLE_COUNT=100000
DEFAULT_ACTIVE_VEHICLE_COUNT=1500

# Degradation model constants (CONTRACT.md §9)
K_CAL=0.0008
K_CYC=0.015
K_THERM=0.004
K_FAST=0.01
K_DEEP=0.008
